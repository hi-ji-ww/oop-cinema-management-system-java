<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <groupId>ru.etu.laskov</groupId><artifactId>cinema-labs</artifactId><version>1.0.0</version>
 <packaging>pom</packaging>
 <properties>
  <maven.compiler.release>8</maven.compiler.release>
  <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
 </properties>
 <modules><module>lab02</module><module>lab03</module><module>lab04</module><module>lab05</module><module>lab06</module><module>lab07</module><module>lab08</module><module>lab09</module></modules>
 <build><pluginManagement><plugins>
  <!-- Компиляция Java исходников с совместимостью Java 8. -->
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
  <!-- Копирование файлов ресурсов в WEB-INF/classes. -->
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
  <!-- Сборка web приложения в WAR архив. -->
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-war-plugin</artifactId><version>3.4.0</version></plugin>
  <!-- Запуск JUnit тестов, формирование отчетов. -->
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>
  <!-- Генерация API документации из комментариев Java. -->
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-javadoc-plugin</artifactId><version>3.6.3</version></plugin>
 </plugins></pluginManagement></build>
</project>
